PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT
JWT_SECRET=replace-with-minimum-32-char-secret-key-here

# Gemini AI (for chatbot)
GEMINI_API_KEY=your-gemini-api-key

# Email (Resend or SMTP)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@sastaplots.com
EMAIL_FROM_NAME=Sasta Plots

# Admin Bootstrap (one-time use)
ADMIN_BOOTSTRAP_SECRET=your-one-time-bootstrap-secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CHATBOT_RATE_LIMIT_MAX=20
